 "segments": [
  {
   "id": "e_cn.4_ac.1_sr.4-0070",
   "kind": "speech",
   "page": 7,
   "speaker": "CHANG",
   "delegation": "China",
   "text": "Dr. CHANG. (China)."
  },
  {
   "id": "e_cn.4_ac.1_sr.4-0071",
   "kind": "heading",
   "page": 8,
   "speaker": null,
   "delegation": null,
   "text": "Article 22"
  },
  {
   "id": "e_cn.4_ac.1_sr.4-0072",
   "kind": "chair",
   "page": 8,
   "speaker": null,
   "delegation": null,
   "text": "The CHAIRMAN said that in her opinion there should be a provision along these lines."
  },
  {
   "id": "e_cn.4_ac.1_sr.4-0073",
   "kind": "speech",
   "page": 8,
   "speaker": "CASSIN",
   "delegation": "France",
   "text": "Prof. CASSIN (France) said he thought it should be grouped with the articles on civil rights."
  },
  {
   "id": "e_cn.4_ac.1_sr.4-0074",
   "kind": "heading",
   "page": 8,
   "speaker": null,
   "delegation": null,
   "text": "Article 23"
  },
  {
   "id": "e_cn.4_ac.1_sr.4-0075",
   "kind": "procedural",
   "page": 8,
   "speaker": null,
   "delegation": null,
   "text": "The inclusion of the substance of Article 23 was sponsored by Prof. CASSIN (France). He believed it might be joined to those articles on the subject of political guarantees."
  },
  {
   "id": "e_cn.4_ac.1_sr.4-0076",
   "kind": "heading",
   "page": 8,
   "speaker": null,
   "delegation": null,
   "text": "Article 24"
  },
  {
   "id": "e_cn.4_ac.1_sr.4-0077",
   "kind": "procedural",
   "page": 8,
   "speaker": null,
   "delegation": null,
   "text": "The inclusion of the substance of Article 24 was sponsored by Prof. CASSIN (France). He stated that in his opinion the Committee might have to draft a text defining the principle of equality."
  },
  {
   "id": "e_cn.4_ac.1_sr.4-0078",
   "kind": "heading",
   "page": 8,
   "speaker": null,
   "delegation": null,
   "text": "Article 25"
  },
  {
   "id": "e_cn.4_ac.1_sr.4-0079",
   "kind": "speech",
   "page": 8,
   "speaker": "CASSIN",
   "delegation": "France",
   "text": "Prof. CASSIN (France) thought that the substance of this article should be retained and connected with the limitations of liberty already discussed."
  },
  {
   "id": "e_cn.4_ac.1_sr.4-0080",
   "kind": "speech",
   "page": 8,
   "speaker": "MALIK",
   "delegation": "Lebanon",
   "text": "Dr. MALIK (Lebanon) remarked that wording of the Secretariat draft was ambiguous. Certain things not prohibited by law are prohibited by other things. The law should not be considered the only law-giver."
  },
  {
   "id": "e_cn.4_ac.1_sr.4-0081",
   "kind": "heading",
   "page": 8,
   "speaker": null,
   "delegation": null,
   "text": "Article 26"
  },
  {
   "id": "e_cn.4_ac.1_sr.4-0082",
   "kind": "procedural",
   "page": 8,
   "speaker": null,
   "delegation": null,
   "text": "The inclusion of the substance of Article 26 was sponsored by Prof. CASSIN (France), who proposed that it be studied in conjunction with Article 6."
  },
  {
   "id": "e_cn.4_ac.1_sr.4-0083",
   "kind": "heading",
   "page": 8,
   "speaker": null,
   "delegation": null,
   "text": "Article 27"
  },
  {
   "id": "e_cn.4_ac.1_sr.4-0084",
   "kind": "procedural",
   "page": 8,
   "speaker": null,
   "delegation": null,
   "text": "The inclusion of the substance of Article 27 was sponsored by Prof. CASSIN (France)."
  },
  {
   "id": "e_cn.4_ac.1_sr.4-0085",
   "kind": "heading",
   "page": 8,
   "speaker": null,
   "delegation": null,
   "text": "Article 28"
  },
  {
   "id": "e_cn.4_ac.1_sr.4-0086",
   "kind": "procedural",
   "page": 8,
   "speaker": null,
   "delegation": null,
   "text": "The inclusion of the substance of Article 28 was sponsored by Dr. CHANG (China). He pointed out, however, that what the United Nations could do about grievances would have to be made clear."
  }
 ]
}