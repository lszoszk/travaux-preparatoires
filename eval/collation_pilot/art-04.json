{
 "article": 4,
 "witnesses": [
  {
   "sigil": "Sec",
   "stage": "secretariat_outline",
   "text": "slavery and compulsory labour are inconsistent with the dignity of man and therefore prohibited by this bill of rights but a man may be required to perform his just share of any public service that is equally incumbent upon all and his right to a livelihood is conditioned by his duty to work involuntary servitude may also be imposed as part of a punishment pronounced by a court of law"
  },
  {
   "sigil": "Cassin",
   "stage": "cassin_draft",
   "text": "slavery which is inconsistent with the dignity of man is prohibited public authority may impose a personal service or work only by application of a law and for the common interest"
  },
  {
   "sigil": "DC1",
   "stage": "drafting_committee_1",
   "text": "slavery which is inconsistent with the dignity of man is prohibited in all its forms"
  },
  {
   "sigil": "WG57",
   "stage": "e_cn4_57",
   "text": "slavery in all its forms being inconsistent with the dignity of man shall be prohibited by law"
  },
  {
   "sigil": "Geneva",
   "stage": "geneva_draft",
   "text": "slavery in all its forms being inconsistent with the dignity of man shall be prohibited by law"
  },
  {
   "sigil": "DC2",
   "stage": "drafting_committee_2",
   "text": "slavery is prohibited in ell its forms"
  },
  {
   "sigil": "CHR3",
   "stage": "chr_3",
   "text": "no one shall be held in slavery or involuntary servitude ko one shall be subjected to torture or to cruel inhuman or degrading treatment or punishment"
  },
  {
   "sigil": "A777",
   "stage": "a777",
   "text": "no one shall be held in slavery or servitude slavery and the slave trade shall be prohibited in all their forms"
  }
 ],
