# Copy to .env next to docker-compose.yml on the VM (docker compose reads it; the rsync in README.md leaves it alone).
# The origin of the site that calls the API from a browser, e.g. https://lszoszk.github.io ; several: comma-separated
TRAVAUX_CORS_ORIGINS=https://CHANGE-ME.github.io
TRAVAUX_VERSION=dev
TRAVAUX_CACHE_SECONDS=300
TRAVAUX_EXPORT_CAP=2000
# The port on the VM's localhost that nginx proxies to (the container itself always listens on 8003). Pick one nothing else uses:
#   docker ps --format "{{.Names}}\t{{.Ports}}"; ss -ltn
TRAVAUX_PORT=8006
# The folder that holds travaux.sqlite3, if it is not ./data next to docker-compose.yml (another disk). On the AMU VM:
# TRAVAUX_DATA_DIR=/mnt/data2/travaux/data
# Ask (search by meaning): the Voyage AI key; leave empty to switch Ask off. The vectors go in TRAVAUX_DATA_DIR/vectors/voyage-3-large.
VOYAGE_API_KEY=
